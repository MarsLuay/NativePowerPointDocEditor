{
	"name": "native-powerpoint-doc-editor",
	"version": "1.1.8",
	"description": "Open, search, and edit DOCX and PPTX files directly in your vault.",
	"main": "main.js",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/MarsLuay/NativePowerPointDocEditor.git"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run i18n:generate && npm run ai:generate && npm run check:ai-capabilities && npm run i18n:validate && npm run check:docx-runtime && npm run check:review-surface && npm run typecheck && node esbuild.config.mjs production && node scripts/check-no-dynamic-script.mjs && node scripts/check-mobile-compat.mjs && node scripts/check-pptx-js-engine-version.mjs && node scripts/check-pptx-action-coverage.mjs && node scripts/check-pptx-action-logs.mjs && node scripts/check-theme-architecture.mjs && node scripts/check-theme-css.mjs && node scripts/check-shared-ui-patterns.mjs",
		"i18n:generate": "node scripts/generate-i18n-types.mjs && node scripts/generate-pseudo-locales.mjs",
		"ai:generate": "node scripts/generate-ai-capabilities.mjs",
		"check:ai-capabilities": "node scripts/generate-ai-capabilities.mjs --check",
		"i18n:validate": "node scripts/validate-locales.mjs",
		"i18n:scan": "node scripts/find-untranslated-strings.mjs",
		"check:no-dynamic-script": "node scripts/check-no-dynamic-script.mjs",
		"check:mobile": "node scripts/check-mobile-compat.mjs",
		"check:pptx-js-engine": "node scripts/check-pptx-js-engine-version.mjs",
		"check:pptx-action-logs": "node scripts/check-pptx-action-logs.mjs",
		"check:theme-architecture": "node scripts/check-theme-architecture.mjs",
		"check:theme-css": "node scripts/check-theme-css.mjs",
		"check:shared-ui-patterns": "node scripts/check-shared-ui-patterns.mjs",
		"check:dead-pptx-controllers": "node --input-type=module -e \"import { readFileSync, existsSync } from 'node:fs'; const view = readFileSync('src/powerpoint/ui/NativePowerPointView.ts', 'utf8'); const controllers = [['arrangeController', 'ArrangeController'], ['insertController', 'InsertController'], ['inspectorController', 'InspectorController'], ['selectionDragController', 'SelectionDragController'], ['textToolbarController', 'TextToolbarController']]; const unused = controllers.filter(([file, symbol]) => !existsSync('src/powerpoint/' + file + '.ts') || !view.includes(\\\"../\\\" + file + \\\"'\\\") || !new RegExp('new\\\\\\\\s+' + symbol + '\\\\\\\\b').test(view)); if (unused.length) { throw new Error('Unused PPTX controllers: ' + unused.map(([file]) => file).join(', ')); }\"",
		"smoke": "node scripts/smoke-native-powerpoint-doc-editor-load.cjs",
		"smoke:chart-axis": "node scripts/smoke-chart-axis-format.mjs",
		"smoke:chart-data": "node scripts/smoke-chart-data-edit.mjs",
		"smoke:generated-text": "node scripts/smoke-generated-text-edit.mjs",
		"smoke:halos": "node scripts/smoke-text-halos.mjs",
		"smoke:selection-geometry": "node scripts/smoke-selection-geometry.mjs",
		"smoke:selection-box-batching": "node scripts/smoke-selection-box-batching.mjs",
		"smoke:annotate-text-offsets": "node scripts/smoke-annotate-text-offsets.mjs",
		"smoke:fonts": "node scripts/smoke-font-fidelity.mjs",
		"smoke:objects": "node scripts/smoke-object-clipboard.mjs",
		"smoke:pptx-js": "node scripts/smoke-pptx-js-engine.mjs",
		"smoke:pptx-action-matrix": "node scripts/smoke-pptx-action-matrix.mjs",
		"smoke:mobile-pptx": "node scripts/smoke-mobile-pptx.mjs",
		"regen:pptx-js": "node scripts/regen-pptx-js-engine.mjs",
		"smoke:pptx-sample": "node scripts/smoke-online-powerpoint-sample.mjs",
		"visual:caret": "node scripts/visual-inline-caret.mjs",
		"visual:zoom": "node scripts/visual-powerpoint-zoom.mjs",
		"test": "node scripts/prepare-vendor-test-runtime.mjs && node scripts/run-plugin-tests.mjs",
		"test:update-fixtures": "node tests/fixtures/generate-fixtures.mjs --write",
		"verify": "npm run verify:review && npm run smoke:pptx-js && npm run smoke:mobile-pptx && npm run smoke:pptx-action-matrix && npm run check:pptx-action-logs",
		"smoke:docx-ime": "node scripts/smoke-docx-ime-neutralizer.mjs",
		"smoke:ai-agent": "node --test tests/ai-schema.test.mjs tests/ai-op-smoke.test.mjs tests/ai-docx-remove-comments.test.mjs tests/ai-export-pdf.test.mjs",
		"verify:docx-ime-live": "node scripts/verify-obsidian-ime-manual-check.mjs",
		"verify:docx-font-roundtrip": "node scripts/verify-docx-font-roundtrip.mjs",
		"audit:docx-pagination": "node scripts/audit-docx-pagination.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
		"check:pptx-action-coverage": "node scripts/check-pptx-action-coverage.mjs",
		"vendor:docx": "node scripts/vendor-docx-editor-runtime.mjs",
		"check:docx-runtime": "node scripts/check-docx-runtime.mjs",
		"check:review-surface": "node scripts/check-review-surface.mjs",
		"typecheck": "tsc --noEmit",
		"lint:repository": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
		"verify:review": "npm run check:docx-runtime && npm run check:review-surface && npm run typecheck && npm run lint:repository && npm run build && npm run test"
	},
	"keywords": [],
	"license": "0-BSD",
	"codeAnalysis": {
		"pluginBundleBudgetBytes": 7340032,
		"pluginBundleBudgetReason": "Single-file offline DOCX and PPTX editing bundles the local document editors, PowerPoint renderer, and JavaScript fallback engine (~5.7MB today). Ceiling leaves room above the 90% monitor warn without pretending the offline footprint is small."
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@eslint/json": "0.14.0",
		"@microsoft/eslint-plugin-sdl": "1.1.0",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"electron": "^42.7.1",
		"esbuild": "0.28.1",
		"eslint": "9.39.5",
		"eslint-plugin-no-unsanitized": "4.1.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "17.7.0",
		"jiti": "2.7.0",
		"knip": "^6.29.0",
		"tslib": "2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.65.0"
	},
	"dependencies": {
		"@radix-ui/react-select": "^2.3.7",
		"clsx": "^2.1.1",
		"docxtemplater": "^3.69.3",
		"dompurify": "3.4.12",
		"heic-decode": "^2.1.0",
		"html2canvas": "^1.4.1",
		"jszip": "^3.10.1",
		"obsidian": "1.12.3",
		"pizzip": "^3.2.0",
		"pptx-svg": "^0.5.10",
		"prosemirror-commands": "1.7.1",
		"prosemirror-dropcursor": "1.8.3",
		"prosemirror-history": "1.5.0",
		"prosemirror-keymap": "1.2.3",
		"prosemirror-model": "1.25.4",
		"prosemirror-state": "1.4.4",
		"prosemirror-tables": "1.8.5",
		"prosemirror-transform": "1.12.0",
		"prosemirror-view": "1.41.8",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sonner": "^2.0.7",
		"xml-js": "^1.6.11"
	},
	"allowScripts": {
		"electron@42.5.0": true
	},
	"overrides": {
		"js-yaml": "^4.2.0",
		"prosemirror-commands": "1.7.1",
		"prosemirror-dropcursor": "1.8.3",
		"prosemirror-history": "1.5.0",
		"prosemirror-keymap": "1.2.3",
		"prosemirror-model": "1.25.4",
		"prosemirror-state": "1.4.4",
		"prosemirror-tables": "1.8.5",
		"prosemirror-transform": "1.12.0",
		"prosemirror-view": "1.41.8",
		"orderedmap": "2.1.1",
		"@eslint/config-array": "0.23.5",
		"brace-expansion": "5.0.8",
		"minimatch": "10.2.5"
	}
}
