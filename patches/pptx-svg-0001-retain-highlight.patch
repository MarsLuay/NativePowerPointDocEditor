+///|
+/// Parse <a:highlight> (run-level highlight color) from child nodes.
+/// Shares the same inner color container as <a:solidFill>.
+/// Returns Color::none() if absent.
+fn parse_highlight(nodes : Array[@xml.XmlNode], theme : ThemeData) -> Color {
+  match @xml.find_child(nodes, "a:highlight") {
+    None => Color::none()
+    Some(hl_node) =>
+      parse_color_from_children(@xml.get_children(hl_node), theme)
+  }
+}
