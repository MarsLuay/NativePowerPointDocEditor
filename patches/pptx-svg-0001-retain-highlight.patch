 }
 
+///|
+test "run highlight survives parse_slide -> serialize round-trip" {
+  // <a:highlight> is authored on a run's rPr. The renderer model previously
+  // dropped it on parse, so any model->serialize cycle (move/resize/fill, undo,
+  // export) silently lost the highlight. Parse must capture it onto the run and
+  // serialize must re-emit it, making the round-trip lossless.
+  let xml =
+    #|<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+    #|<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="TextBox"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="100000" y="100000"/><a:ext cx="500000" cy="300000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr/><a:p><a:r><a:rPr lang="en-US"><a:highlight><a:srgbClr val="FFFF00"/></a:highlight></a:rPr><a:t>lit</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld></p:sld>
+  let slide = @ooxml.parse_slide(
+    xml,
+    @ooxml.SlideSize::default(),
+    @ooxml.ThemeData::default(),
+  )
+  // Parse captured the highlight onto the run.
+  let run = slide.shapes[0].paragraphs[0].runs[0]
+  assert_eq(run.highlight.r, 255)
+  assert_eq(run.highlight.g, 255)
+  assert_eq(run.highlight.b, 0)
+  // Serialize re-emits <a:highlight>, and the cycle is a fixed point.
+  let out = serialize_slide(slide)
+  assert_true(out.contains("<a:highlight><a:srgbClr val=\"FFFF00\"/></a:highlight>"))
+  let slide2 = @ooxml.parse_slide(
+    out,
+    @ooxml.SlideSize::default(),
+    @ooxml.ThemeData::default(),
+  )
+  assert_eq(out, serialize_slide(slide2))
+}
