{
	"compilerOptions": {
		"baseUrl": "src",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"paths": {
			"@eigenpal/docx-editor-agents": [
				"vendor/eigenpal/docx-editor-agents/dist/index.d.ts"
			],
			"@eigenpal/docx-editor-agents/*": [
				"vendor/eigenpal/docx-editor-agents/dist/*/index.d.ts",
				"vendor/eigenpal/docx-editor-agents/dist/*.d.ts"
			],
			"@eigenpal/docx-editor-core": [
				"vendor/eigenpal/docx-editor-core/dist/core.d.ts"
			],
			"@eigenpal/docx-editor-core/*": [
				"vendor/eigenpal/docx-editor-core/dist/*/index.d.ts",
				"vendor/eigenpal/docx-editor-core/dist/*.d.ts"
			],
			"@eigenpal/docx-editor-i18n": [
				"vendor/eigenpal/docx-editor-i18n/dist/index.d.ts"
			],
			"@eigenpal/docx-editor-i18n/*": [
				"vendor/eigenpal/docx-editor-i18n/dist/*.d.ts"
			],
			"@eigenpal/docx-editor-react": [
				"vendor/eigenpal/docx-editor-react/dist/index.d.ts"
			],
			"@eigenpal/docx-editor-react/*": [
				"vendor/eigenpal/docx-editor-react/dist/*/index.d.ts",
				"vendor/eigenpal/docx-editor-react/dist/*.d.ts"
			]
		},
		"jsx": "react-jsx",
		"noImplicitAny": true,
		"noImplicitThis": true,
		"noImplicitReturns": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"strictBindCallApply": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"useUnknownInCatchVariables": true,
		"lib": [
			"DOM",
			"ES5",
			"ES6",
			"ES7",
			"ES2022"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx"
	]
}
