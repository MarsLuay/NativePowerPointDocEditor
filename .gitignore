# vscode
.vscode

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include compiled plugin runtime artifacts in the repo.
# They should be uploaded to GitHub releases instead.
main.js
pptx-js-engine.mjs
pptx-wasm-renderer.mjs
heic-decode.mjs
ai/capabilities.json

# Exclude sourcemaps
*.map

# TypeScript is authoritative; do not track emitted source mirrors.
/src/**/*.js

# Vendored Eigenpal packages require their published runtime and declaration artifacts.
!/src/vendor/eigenpal/*/dist/
!/src/vendor/eigenpal/*/dist/**

# Visual smoke output
scripts/visual-output/
scripts/.cache/
test-results/

# Local manual test documents
test_files/

# obsidian
data.json

# Local harness / probe artifacts (vault-only scratch output)
results/
tmp-meta-main.js
test-ime-probe.docx
ctxbar-review.mjs
probe*.mjs
tests/_probe-*.mjs

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Local-only AI-interfacing design doc (not for release)
docs/AGENT-API.md

# Editable DOCX source is maintained only on the docx-editor-source branch.
# Keep a local checkout here for analysis if useful, but never commit it on a
# vendor-only release branch.
/docx-editor/
docx-editor/node_modules/
docx-editor/**/node_modules/
docx-editor/**/.turbo/
docx-editor/**/tsconfig.tsbuildinfo

# Monorepo extras not required for Obsidian bundle / CI rebuild of package dist
docx-editor/reference/
docx-editor/examples/
docx-editor/docs/
docx-editor/.gstack/
docx-editor/screenshots/
docx-editor/.ralph/
